# ══════════════════════════════════════════════════════════════════════════════
#  .dockerignore — جذر المشروع
#  يُستخدم عند: docker-compose build (context = project root)
#  الهدف: إرسال أقل قدر ممكن للـ Docker daemon → بناء أسرع
# ══════════════════════════════════════════════════════════════════════════════

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Frontend (لا يحتاجها الـ backend image) ──────────────────────────────────
frontend/
frontend-saas/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Python virtual envs ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── بيانات وهمية/تجريبية ────────────────────────────────────────────────────
charity_data*.json
*_data_*.json
reports/

# ── أسرار البيئة (لا تدخل الـ image أبداً) ───────────────────────────────────
.env
*.env
env.example

# ── أدوات التطوير ────────────────────────────────────────────────────────────
.github/
.vscode/
.idea/
*.md
Makefile
docker-compose*.yml

# ── Node (في حال وُجد) ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
