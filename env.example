# ════════════════════════════════════════════════════════════════════════════════
#  env.example — قم بنسخ هذا الملف إلى .env ثم عدّل القيم
#  انسخه: cp env.example .env
#  تحذير: لا تُودع .env في Git أبداً — أضفه إلى .gitignore
# ════════════════════════════════════════════════════════════════════════════════

# ── JWT Authentication ────────────────────────────────────────────────────────
# أنشئ مفتاحاً عشوائياً: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET-IN-PRODUCTION
TOKEN_EXPIRE_HOURS=24

# ── Supabase (اختياري — يتراجع إلى JSON عند الغياب) ─────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# أضف نطاقاتك الفعلية مفصولة بفواصل، أو اترك * للتطوير فقط
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── API Admin System User ─────────────────────────────────────────────────────
API_ADMIN_ID=API-ADMIN

# ── Next.js Frontend (Docker: http://backend:8000 | Local: http://localhost:8000)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
